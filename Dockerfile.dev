# OpenQuantum V2 - Development Dockerfile with hot reload
FROM node:22-alpine

# Install dependencies
RUN apk add --no-cache libc6-compat git

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml* ./

# Install dependencies - ignore sharp build script warning
RUN pnpm config set ignore-scripts true && pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Development command with polling for file changes in Docker
ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=true
ENV CI=true

CMD ["pnpm", "dev"]