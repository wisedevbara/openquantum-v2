# OpenQuantum V2 - Docker ignore file
# Exclude files not needed in Docker builds

# Git
.git
.gitignore

# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
out
build
dist

# Testing
coverage
.nyc_output

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.production.local
.env.development.local

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
CHANGELOG.md
LICENSE

# Scripts (optional - exclude if not needed in container)
scripts/
*.sh

# TypeScript
*.tsbuildinfo

# Misc
*.pem
.vercel
.netlify